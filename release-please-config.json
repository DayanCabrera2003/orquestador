{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "draft": true,
  "force-tag-creation": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Novedades"
    },
    {
      "type": "fix",
      "section": "Correcciones"
    },
    {
      "type": "perf",
      "section": "Rendimiento"
    },
    {
      "type": "refactor",
      "section": "Refactorizaciones",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentación",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Mantenimiento",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Estilo",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "orquestador"
    }
  }
}
