    "start": "pnpm --filter @orquestador/web build && node build.mjs && electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.3.295",
    "electron-updater": "~6.8.9",
    "node-pty": "~1.1.0"
  },
  "devDependencies": {
    "@orquestador/server": "workspace:*",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "esbuild": "~0.25.12"
  }
}
