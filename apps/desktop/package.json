{
  "name": "@orquestador/desktop",
  "productName": "Orquestador",
  "version": "0.0.0",
  "private": true,
  "description": "Orquestador de sesiones de agentes de código",
  "author": "Dayan Cabrera",
  "license": "MIT",
  "type": "module",
  "main": "out/main.mjs",
  "scripts": {
    "build": "node build.mjs",
